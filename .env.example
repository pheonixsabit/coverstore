# MoveOn Business Account Authentication
# To crawl using your MoveOn business account:
# 1. Open moveon.global in Chrome/Edge and log in to your business account.
# 2. Press F12 -> Application -> Local Storage -> https://moveon.global
# 3. Copy the 'token' or 'auth_token' value and paste it below:
MOVEON_AUTH_TOKEN=

# Pathao Commerce Merchant Authentication
# Enter your login email/phone and password for https://commerce.pathao.com
PATHAO_EMAIL_OR_PHONE=
PATHAO_PASSWORD=
PATHAO_DEFAULT_STOCK=10
